---
import BaseLayout from "./BaseLayout.astro";
import { SignedIn, SignedOut } from "@clerk/astro/components";
import Prose from '../components/Prose.astro';

// the layout used by /info.md and /privacy.md
---

<BaseLayout>
    <main class="min-h-screen flex flex-col place-content-center place-items-center p-4 info-main">
        <SignedOut>
            <Prose>
                <h1 class="text-base-content">404: Page Not Found</h1>
            </Prose>
        </SignedOut>
        <SignedIn>
            <Prose>
                <slot/>
            </Prose>
        </SignedIn>
        <a class="text-primary link text-2xl lg:text-3xl mt-2" href="/">Return to Home Page</a>
    </main>
</BaseLayout>